<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AssetNameCaseFixes</AssemblyName>
    <RootNamespace>AssetNameCaseFixes</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <GamePath Condition="'$(GamePath)' == ''">$(STARDEW_VALLEY_PATH)</GamePath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>AssetNameCaseFixes/</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);AssetNameCaseFixes/**</DefaultItemExcludes>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="StardewModdingAPI">
      <HintPath>$(GamePath)/StardewModdingAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Stardew Valley">
      <HintPath>$(GamePath)/Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(GamePath)/MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/smapi-internal/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckGamePath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(GamePath)' == '' Or !Exists('$(GamePath)/StardewModdingAPI.dll')">
    <Error Text="Game folder not found. Pass it with -p:GamePath=&quot;/path/to/Stardew Valley&quot; or set the STARDEW_VALLEY_PATH environment variable." />
  </Target>

</Project>
